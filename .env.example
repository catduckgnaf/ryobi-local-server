# Copy to .env and edit. Only RYOBI_DEVICE_ID is required.

# Your opener's varName, looks like GDO_XXXXXXXXXX (see README: Finding your device ID)
RYOBI_DEVICE_ID=
RYOBI_DEVICE_NAME=Garage Door

# Host port Home Assistant will connect to
HTTP_PORT=8080

# Optional: if set, Home Assistant must log in with exactly these credentials.
# Also required for RYOBI_CLOUD_POLL=true.
# RYOBI_USERNAME=
# RYOBI_PASSWORD=

# Mirror state from Ryobi's real cloud every N seconds (needs internet + credentials)
# RYOBI_CLOUD_POLL=false
# RYOBI_POLL_INTERVAL=30

# POST open/close/light commands to an ESP or Pi relay
# RYOBI_COMMAND_WEBHOOK_URL=http://192.168.1.60/command

# Experimental DNS redirect mode only (docs/DNS.md)
# SSL_ENABLED=true
# ADVERTISE_IP=192.168.1.50
