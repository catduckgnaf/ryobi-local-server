# Ryobi GDO Local Server - Example Configuration
#
# Copy this to config.yaml and fill in your values.
# Environment variables (see .env.example) override anything set here.

# ---------------------------------------------------------------------------
# Ryobi account credentials
# Used for cloud polling (cloud_poll: true) and login enforcement.
# Leave blank to accept any credentials from the HA integration.
# ---------------------------------------------------------------------------
username: "your_ryobi_email@example.com"
password: "your_ryobi_password"

# ---------------------------------------------------------------------------
# Devices
# Add one entry per garage door opener on your account.
# device_id: the Ryobi "varName" for your opener.
#   See "Finding your device ID" in the README.
# ---------------------------------------------------------------------------
devices:
  - device_id: "GDO_XXXXXXXXXX"
    name: "Garage Door"
    # Optional: specify which modules are present on this device.
    # Keys are Ryobi module names, values are the "key_in_deviceTypeMap" strings.
    # If omitted, sensible defaults are used (garageDoor_7, garageLight_7, etc.)
    modules:
      garageDoor: "garageDoor_7"
      garageLight: "garageLight_7"
      # backupCharger: "backupCharger_6"   # uncomment if you have a battery backup
      # wifiModule: "wifiModule_7"
      # parkAssistLaser: "parkAssistLaser_1"
      # inflator: "inflator_4"
      # btSpeaker: "btSpeaker_2"

  # Uncomment to add a second door:
  # - device_id: "GDO_YYYYYYYYYY"
  #   name: "Garage Door 2"

# ---------------------------------------------------------------------------
# Cloud polling — disabled by default for fully offline / no-internet mode.
#
# Set to true ONLY if you want the server to also mirror state from Ryobi's
# real cloud (graceful degradation). Leave false for pure LAN operation.
# ---------------------------------------------------------------------------
cloud_poll: false
poll_interval: 30   # seconds (used only if cloud_poll: true)

# ---------------------------------------------------------------------------
# Command webhook (HIGHLY RECOMMENDED for full local control)
#
# When Home Assistant sends an open/close/light command via WebSocket,
# this server will POST a JSON command to the URL below so your Pi or ESP
# can fire a physical relay connected to the door's wall-button terminals.
#
# The server POSTs: {"command": "open"|"close"|"toggle", "device_id": "...", "module": "garageDoor", "attr": "doorState", "value": "1"}
#
# Any HTTP endpoint that accepts a JSON POST works (Pi, Node-RED, etc.)
# Example ESPHome config is in examples/esphome_ryobi.yaml
# ---------------------------------------------------------------------------
# command_webhook_url: "http://192.168.1.50:5000/command"
# command_webhook_timeout: 3   # seconds

# ---------------------------------------------------------------------------
# Security
# If enforce_token is true, WebSocket connections must use a valid API key
# obtained from POST /api/login. Set to false for development.
# ---------------------------------------------------------------------------
enforce_token: false
